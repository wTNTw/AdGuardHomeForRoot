diff --git a/internal/snifilter/firewall_linux.go b/internal/snifilter/firewall_linux.go
index 9707279..0a606c1 100644
--- a/internal/snifilter/firewall_linux.go
+++ b/internal/snifilter/firewall_linux.go
@@ -48,6 +48,26 @@ const (
 	// queueWriteTimeout is the time the queue waits to hand the packet over
 	// to the kernel.
 	queueWriteTimeout = 20 * time.Millisecond
+
+	// queueReadBuffer is the size of the receive buffer of the netlink socket
+	// the queue is read through.  The kernel copies up to [queueCopyRange]
+	// bytes of each packet into a single netlink message, so the default
+	// socket buffer of a few hundred kilobytes holds only about a hundred
+	// packets.  A burst of the parallel TLS handshakes, which is what a single
+	// page load produces, overflows it: the read returns ENOBUFS and the
+	// kernel drops the packets.  The socket buffer is a limit rather than a
+	// preallocation, so this value only costs the memory that is actually
+	// used.
+	queueReadBuffer = 8 << 20
+
+	// queueReadBufferMin is the fallback of [queueReadBuffer] for the kernels
+	// whose net.core.rmem_max clamps the value below it.
+	queueReadBufferMin = 1 << 20
+
+	// queueReopenMinDelay and queueReopenMaxDelay bound the backoff of the
+	// queue re-registration, see [Filter.watchQueueLoop].
+	queueReopenMinDelay = 1 * time.Second
+	queueReopenMaxDelay = 30 * time.Second
 )
 
 // eventFDValue is the value written to the eventfds used as wakeup and queue
@@ -245,6 +265,8 @@ func (f *Filter) dialQueue(ctx context.Context, stoppedFD int) (nf *nfqueue.Nfqu
 		return nil, err
 	}
 
+	f.enlargeQueueReadBuffer(ctx, nf)
+
 	err = nf.RegisterWithErrorFunc(ctx, func(a nfqueue.Attribute) (ret int) {
 		ret = f.handlePacket(nf, a)
 		if ret != 0 {
@@ -285,6 +307,30 @@ func (f *Filter) dialQueue(ctx context.Context, stoppedFD int) (nf *nfqueue.Nfqu
 	return nf, nil
 }
 
+// enlargeQueueReadBuffer raises the receive buffer of the netlink socket of nf,
+// so that a burst of the packets doesn't overflow it.  A failure isn't fatal:
+// the queue keeps working with the default buffer, it just drops the packets
+// earlier.
+func (f *Filter) enlargeQueueReadBuffer(ctx context.Context, nf *nfqueue.Nfqueue) {
+	for _, size := range []int{queueReadBuffer, queueReadBufferMin} {
+		err := nf.Con.SetReadBuffer(size)
+		if err == nil {
+			f.logger.DebugContext(ctx, "enlarged the nfqueue read buffer", "bytes", size)
+
+			return
+		}
+
+		f.logger.WarnContext(
+			ctx,
+			"enlarging the nfqueue read buffer",
+			"bytes",
+			size,
+			slogutil.KeyError,
+			err,
+		)
+	}
+}
+
 // startQueue opens the queue and starts the watcher that re-registers it if
 // the kernel drops it.  ctx must be canceled to stop the watcher.
 func (f *Filter) startQueue(ctx context.Context) (err error) {
@@ -431,11 +477,45 @@ func (f *Filter) watchQueueLoop(
 		oldStoppedFD := stoppedFD
 		nf, stoppedFD, err = f.reopenQueue(ctx)
 		closeQueueStoppedFD(oldStoppedFD)
-		if err != nil {
-			f.logger.ErrorContext(ctx, "re-registering the nfqueue", slogutil.KeyError, err)
 
-			return
+		// The kernel may still be unbinding the previous instance of the queue
+		// number, and binding it back too early fails with EBUSY, EPERM, or a
+		// netlink sequence mismatch.  Giving up after the first failure leaves
+		// the filter without a queue until the process is restarted, which is
+		// exactly the silent SNI outage this watcher exists to prevent, so the
+		// failures are retried with a backoff until the queue is back or ctx
+		// is canceled.
+		delay := queueReopenMinDelay
+		for attempt := 1; err != nil; attempt++ {
+			f.logger.ErrorContext(
+				ctx,
+				"re-registering the nfqueue",
+				"queue_num",
+				f.queueNum,
+				"attempt",
+				attempt,
+				"retry_in",
+				delay,
+				slogutil.KeyError,
+				err,
+			)
+
+			select {
+			case <-ctx.Done():
+				return
+			case <-time.After(delay):
+			}
+
+			if delay *= 2; delay > queueReopenMaxDelay {
+				delay = queueReopenMaxDelay
+			}
+
+			oldStoppedFD = stoppedFD
+			nf, stoppedFD, err = f.reopenQueue(ctx)
+			closeQueueStoppedFD(oldStoppedFD)
 		}
+
+		f.logger.InfoContext(ctx, "the nfqueue has been re-registered", "queue_num", f.queueNum)
 	}
 }
 
