#!/bin/sh /etc/rc.common
# /etc/init.d/agh-sni-watchdog -- 守护 /usr/bin/agh-sni-watchdog.sh
# 与 AdGuardHome 自身解耦：核心内的自愈失败时仍会有人把它拉起来。
USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/agh-sni-watchdog.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
